{
    "key": "nfgpnenebhkajcedaipjapllgcbgadjb",
    "name": "Lock In",
    "description": "Block distracting websites and intelligently filter YouTube and Reddit content. Stay focused, reduce distractions, and take back control of your time.",
    "version": "1.0",
    "manifest_version": 3,
    "icons": {
        "16":"icons/16.png",
        "32":"icons/32.png",
        "48":"icons/48.png",
        "128":"icons/128.png"
    },
    "action": {
        "default_popup":"popup.html"
    },
    "options_ui": {
    "page": "options.html",
    "open_in_tab": true
    },
    "permissions": [
        "storage", 
        "declarativeNetRequest",
        "declarativeNetRequestWithHostAccess",
        "tabs",
        "activeTab",
        "webNavigation",
        "scripting",
        "alarms",
        "notifications"
    ],
    "externally_connectable": {
        "matches": ["http://localhost:8000/*"]
    },
    "host_permissions": ["<all_urls>"],
    "content_security_policy": {
        "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
    },
    "background":{
        "service_worker": "background.js",
        "type": "module"
    },
    "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}